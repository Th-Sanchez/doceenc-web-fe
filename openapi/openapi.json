          "price": {
            "$ref": "#/components/schemas/PriceRequest"
          }
        },
        "required": [
          "baseUnit",
          "categoryId",
          "name",
          "price"
        ]
      },
      "PriceRequest": {
        "type": "object",
        "properties": {
          "packagePrice": {
            "type": "number",
            "minimum": 0.01
          },
          "packageQuantity": {
            "type": "number",
            "minimum": 0.01
          },
          "unit": {
            "type": "string",
            "enum": [
              "G",
              "KG",
              "ML",
              "L",
              "UNIT"
            ]
          },
          "purchasedOn": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "packagePrice",
          "packageQuantity",
          "unit"
        ]
      },
      "CreateCategoryRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 0
          },
          "type": {
            "type": "string",
            "enum": [
              "INGREDIENT",
              "RECIPE"
            ]
          }
        },
        "required": [
          "name",
          "type"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 255,
            "minLength": 0
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 0
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RecipeSummaryResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "$ref": "#/components/schemas/RecipeCategoryResponse"
          },
          "yieldQuantity": {
            "type": "number"
          },
          "yieldUnit": {
            "type": "string",
            "enum": [
              "GRAM",
              "MILLILITER",
              "UNIT"
            ]
          },
          "prepTimeMinutes": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "shelfLifeDays": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "active": {
            "type": "boolean"
          },
          "itemCount": {
            "type": "integer",
            "format": "int32"
          },
          "archivedIngredientCount": {
            "type": "integer",
            "format": "int32"
          },
          "totalCost": {
            "type": "number"
          },
          "costPerYieldUnit": {
            "type": "number"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "active",
          "archivedIngredientCount",
          "category",
          "costPerYieldUnit",
          "createdAt",
          "id",
          "itemCount",
          "name",
          "prepTimeMinutes",
          "shelfLifeDays",
          "totalCost",
          "updatedAt",
          "yieldQuantity",
          "yieldUnit"
        ]
      },
      "PriceHistoryResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "packagePrice": {
            "type": "number"
          },
          "packageQuantity": {
            "type": "number"
          },
          "unitPrice": {
            "type": "number"
          },
          "purchasedOn": {
            "type": "string",
            "format": "date"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "createdAt",
          "id",
          "packagePrice",
          "packageQuantity",
          "purchasedOn",
          "unitPrice"
        ]
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        },
        "required": [
          "email"
        ]
      },
      "FieldProblem": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "Field path, e.g. \"price.packagePrice\"."
          },
          "code": {
            "type": "string",
            "description": "Bean validation constraint, e.g.\"NotBlank\"."
          }
        },
        "required": [
          "code",
          "field"
        ]
      },
      "ProblemDetail": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "Stable error code; the UI text is chosen from it."
          },
          "retryAfterSeconds": {
            "type": "integer",
            "format": "int64"
          },
          "errors": {
            "type": "array",
            "description": "Only for VALIDATION_FAILED.",
            "items": {
              "$ref": "#/components/schemas/FieldProblem"
            }
          }
        },
        "required": [
          "code",
          "status"
        ]
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "name": "SESSION",
        "in": "cookie"
      }
    }
  }
}
